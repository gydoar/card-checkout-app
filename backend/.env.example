# Copia este archivo como .env y completa los valores.
# Las llaves de la pasarela se entregan con la prueba técnica: NO se versionan.

PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Base de datos (docker-compose.yml expone Postgres en el 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=checkout
DB_PASSWORD=checkout_local_pw
DB_NAME=checkout
DB_SSL=false

# Pasarela de pagos (ambiente SANDBOX)
PAYMENT_GATEWAY_BASE_URL=https://<sandbox-host-de-la-pasarela>/v1
PAYMENT_GATEWAY_PUBLIC_KEY=pub_stagtest_xxx
PAYMENT_GATEWAY_PRIVATE_KEY=prv_stagtest_xxx
PAYMENT_GATEWAY_INTEGRITY_SECRET=stagtest_integrity_xxx
PAYMENT_GATEWAY_EVENTS_SECRET=stagtest_events_xxx

# Tarifas en centavos (COP). Tarifa base = siempre se cobra; envío = por pedido.
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=1000000
